__pycache__/
*.pyc
*.pyo
*.swp
*.out
*.restart
*.restart.*
.pytest_cache/

# Secrets / site-local env
cluster.env
**/cluster.env

# CP2K run outputs / cluster-generated paths (regenerate on Alpine)
cp2k-stress-pressure-workflows/**/pIso_*/
cp2k-stress-pressure-workflows/uniax/deltaPramp/axes/
cp2k-stress-pressure-workflows/uniax/deltaPramp/axes_manifest.json
cp2k-stress-pressure-workflows/scfhel/minima_scale_*.json
cp2k-stress-pressure-workflows/**/*.log

# Energetic NMA: keep trajectories / pressure run trees local
energetic-normal-mode-analysis/**/AnimationFiles/
energetic-normal-mode-analysis/**/anime_*.xyz
energetic-normal-mode-analysis/**/output_*.xyz
energetic-normal-mode-analysis/**/backup/
energetic-normal-mode-analysis/**/old/
energetic-normal-mode-analysis/**/minamb/
energetic-normal-mode-analysis/**/*GPa/
energetic-normal-mode-analysis/.pytest_cache/

# NPL / QE staged trees: keep run debris out if reintroduced
npl-core-shell-pressure/**/*.out
npl-core-shell-pressure/**/*.restart*
npl-core-shell-pressure/**/QM_*-POS-pos-*.xyz
npl-core-shell-pressure/**/*.Hessian
npl-core-shell-pressure/**/*.Log
qe-benzene-pressure/**/*.out
qe-benzene-pressure/**/*.save/
