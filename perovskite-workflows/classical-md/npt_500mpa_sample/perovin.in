#################### SETTING UP ####################
units      metal
boundary   p p p
atom_style full
#
pair_style      hybrid lj/cut/coul/long 10.0 buck/coul/long 10.0
bond_style      harmonic
angle_style     harmonic
dihedral_style  charmm
special_bonds   amber
# Provide this data file locally (not bundled).
read_data    lammps_data_full_supercell.data
kspace_style pppm  1.0e-6
pair_modify  table 0

#################### VARIABLES ####################
variable Temp equal 300       # Temperature in K
variable Pres equal 5000.0    # Pressure in atm (~500 MPa)

variable RandomSeed equal 345345
variable tstep equal 0.0005      # ps
variable Ninpt equal 350000   # NPT equilibration steps
variable Npnpt equal 1000000  # NPT production steps
variable Nf equal 10
variable Ne equal  10
variable Nr equal ${Nf}/${Ne}

variable dumpT              equal 10*${tstep}
variable dumpP              equal 100*${tstep}
variable ndump_xtc          equal 1000

#################### INITIALIZATION ####################
group C_  type 1 2
group N_  type 3 4
group H_  type 5 6
group Pb_ type 7
group I_  type 8
group Br_ type 9

velocity     all create ${Temp} ${RandomSeed} dist gaussian
velocity     all zero linear
velocity     all zero angular

thermo ${Nf}

#################### 1) Minimize ####################
min_style cg
minimize 1.0e-6 1.0e-8 1000 10000

write_dump all xyz optimized_structure.xyz modify element C C N N H H Pb I Br sort id

#################### 2) NPT equilibration ####################
velocity all create ${Temp} ${RandomSeed} dist gaussian
velocity all zero linear
velocity all zero angular

fix integrate all npt temp ${Temp} ${Temp} ${dumpT} iso ${Pres} ${Pres} ${dumpP}
thermo_style custom step temp etotal cella cellb cellc vol press
reset_timestep 0
timestep ${tstep}
run ${Ninpt}
unfix integrate
reset_timestep 0

#################### 3) NPT production ####################
fix integrate all npt temp ${Temp} ${Temp} ${dumpT} iso ${Pres} ${Pres} ${dumpP}

group CNatoms type 1 2 3 4
dump CNdump CNatoms custom 100 CN_atoms.lammpstrj id type x y z
dump_modify CNdump sort id

dump ver_sistema all custom 1000 npt_production.lammpstrj id type x y z
dump_modify ver_sistema element C C N N H H Pb I Br sort id

run ${Npnpt}

write_dump all xyz npt_final.xyz modify element C C N N H H Pb I Br sort id

unfix integrate
undump CNdump
undump ver_sistema
