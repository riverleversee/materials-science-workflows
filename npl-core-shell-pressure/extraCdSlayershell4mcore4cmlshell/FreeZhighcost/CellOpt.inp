&GLOBAL
  PROJECT QM_cellopt
  RUN_TYPE CELL_OPT
  EXTENDED_FFT_LENGTHS
  PRINT_LEVEL MEDIUM


&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &PRINT
   &STRESS_TENSOR
    &EACH
     GEO_OPT 1
    &END EACH
   &END STRESS_TENSOR
   &FORCES
    &EACH 
      GEO_OPT 1
    &END EACH
   &END FORCES 
  &END PRINT

  &DFT
    BASIS_SET_FILE_NAME /projects/rile5166/QEme/NPL/FullPlatelet/CP2K/BASISPOT/basislocaltz
    POTENTIAL_FILE_NAME /projects/rile5166/QEme/NPL/FullPlatelet/CP2K/BASISPOT/potlocal

    &KPOINTS
      SCHEME MONKHORST-PACK 12 12 2
    &END KPOINTS
    &MGRID
      CUTOFF 2400
      REL_CUTOFF 240
    &END MGRID
    &QS
      METHOD GPW
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-9
      MAX_SCF 100


      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.35
        BETA 0.3
      &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART

      &END PRINT
      
   &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT




  &SUBSYS
    &CELL
        @INCLUDE 'optimized_cell.cell'
         SYMMETRY TETRAGONAL_AB  
     PERIODIC  XYZ
    &END CELL
   &COORD
      @INCLUDE 'coordinates.xyz'
    &END COORD
  

&KIND Cd
  ELEMENT Cd
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q12
  POTENTIAL GTH-PBE-q12
&END KIND
&KIND Zn
  ELEMENT Zn
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q12
  POTENTIAL GTH-PBE-q12
&END KIND
&KIND Se
  ELEMENT Se
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q6
  POTENTIAL GTH-PBE-q6
&END KIND
&KIND S
  ELEMENT S
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q6
  POTENTIAL GTH-PBE-q6
&END KIND
&KIND O
  ELEMENT O
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q6
  POTENTIAL GTH-PBE-q6
&END KIND
&KIND C
  ELEMENT C
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q4
  POTENTIAL GTH-PBE-q4
&END KIND
&KIND H
  ELEMENT H
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q1
  POTENTIAL GTH-PBE-q1
&END KIND

  &PRINT

  &ATOMIC_COORDINATES ON
    &EACH 
       GEO_OPT 1 
       CELL_OPT 1
        
     &END EACH
 
 &END ATOMIC_COORDINATES 
&END PRINT 

 &END SUBSYS
&END FORCE_EVAL

&MOTION
  
  &CELL_OPT
   MAX_FORCE 1.0E-5
  KEEP_ANGLES T
 KEEP_SYMMETRY T    
OPTIMIZER BFGS
    MAX_ITER 200
    TYPE DIRECT_CELL_OPT
    EXTERNAL_PRESSURE 0
    PRESSURE_TOLERANCE 10 
    &PRINT
     &CELL ON
      &EACH
        CELL_OPT 1
      &END EACH 
      FILENAME optimized_cell.dat
        ADD_LAST NUMERIC
  
         
      &END CELL
      
    &END PRINT
  

   &END CELL_OPT
  &GEO_OPT
   OPTIMIZER BFGS
    &BFGS
    TRUST_RADIUS 0.1
     &END BFGS
    MAX_ITER 100
 &END GEO_OPT
 &PRINT 
   &TRAJECTORY ON
      
     &EACH 
         GEO_OPT 1
         CELL_OPT 1
     &END EACH 
     FILENAME POS
    &END TRAJECTORY 
  
 &END PRINT 

&END MOTION              

