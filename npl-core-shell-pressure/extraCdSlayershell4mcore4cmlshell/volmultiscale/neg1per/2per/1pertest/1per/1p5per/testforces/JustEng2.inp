&GLOBAL
  PROJECT QM_cellopt
  RUN_TYPE ENERGY_FORCE 
  EXTENDED_FFT_LENGTHS
  PRINT_LEVEL MEDIUM


&END GLOBAL

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &PRINT
   &STRESS_TENSOR
    &EACH
    JUST_ENERGY 1
    &END EACH
    FILENAME stressfile2
   &END STRESS_TENSOR

  &END PRINT

  &DFT
    BASIS_SET_FILE_NAME /projects/rile5166/QEme/NPL/FullPlatelet/CP2K/BASISPOT/basislocaltz
    POTENTIAL_FILE_NAME /projects/rile5166/QEme/NPL/FullPlatelet/CP2K/BASISPOT/potlocal

    &KPOINTS
      SCHEME MONKHORST-PACK 12 12 2
    &END KPOINTS
    &MGRID
      CUTOFF 2400
      REL_CUTOFF 240
    &END MGRID
    &QS
      METHOD GPW
    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-9
      MAX_SCF 100
&OUTER_SCF
MAX_SCF 2
 EPS_SCF 1.0E-10
 &END OUTER_SCF


      &MIXING
        METHOD BROYDEN_MIXING
        ALPHA 0.35
        BETA 0.3
      &END MIXING


   &END SCF
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
    &END XC
  &END DFT




  &SUBSYS
    &CELL
        #ABC 4.0 4.0 72.0
        @INCLUDE 'optimized_cell.cell'
         SYMMETRY TETRAGONAL_AB  
     PERIODIC  XYZ
    &END CELL
   &COORD
      @INCLUDE 'coordinates2.xyz'
    &END COORD



&KIND Cd
  ELEMENT Cd
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q12
  POTENTIAL GTH-PBE-q12
&END KIND
&KIND Zn
  ELEMENT Zn
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q12
  POTENTIAL GTH-PBE-q12
&END KIND
&KIND Se
  ELEMENT Se
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q6
  POTENTIAL GTH-PBE-q6
&END KIND
&KIND S
  ELEMENT S
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q6
  POTENTIAL GTH-PBE-q6
&END KIND
&KIND O
  ELEMENT O
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q6
  POTENTIAL GTH-PBE-q6
&END KIND
&KIND C
  ELEMENT C
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q4
  POTENTIAL GTH-PBE-q4
&END KIND
&KIND H
  ELEMENT H
  BASIS_SET ORB TZV2P-MOLOPT-PBE-GTH-q1
  POTENTIAL GTH-PBE-q1
&END KIND

  &PRINT

  &ATOMIC_COORDINATES ON
    &EACH 
       GEO_OPT 1 
       CELL_OPT 1
       JUST_ENERGY 1 
     &END EACH
     FILENAME pos.xyz
 
 &END ATOMIC_COORDINATES 
&END PRINT 

 &END SUBSYS
&END FORCE_EVAL

&MOTION
  &CELL_OPT
  CONSTRAINT Z
  KEEP_ANGLES T
  KEEP_SYMMETRY 
    OPTIMIZER BFGS
    MAX_ITER 200
    TYPE DIRECT_CELL_OPT
    EXTERNAL_PRESSURE 0 
    &PRINT
     &CELL ON
      &EACH
        CELL_OPT 1
      &END EACH 
      FILENAME optimized_cell.dat
        ADD_LAST NUMERIC
  
         
      &END CELL
      
    &END PRINT
  

   &END CELL_OPT
  &GEO_OPT
   OPTIMIZER BFGS
    &BFGS
    TRUST_RADIUS 0.04
     &END BFGS
    MAX_ITER 1
 &END GEO_OPT
 &PRINT 
   &TRAJECTORY ON
      
     &EACH 
         GEO_OPT 1
         CELL_OPT 1
         JUST_ENERGY 1
     &END EACH 
     FILENAME pos.xyz
    &END TRAJECTORY 
  
 &END PRINT 

&END MOTION              

