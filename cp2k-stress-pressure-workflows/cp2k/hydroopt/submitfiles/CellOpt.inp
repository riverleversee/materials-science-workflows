&GLOBAL
  PROJECT QM_cellopt
  RUN_TYPE CELL_OPT
  PRINT_LEVEL MEDIUM


&END GLOBAL

&FORCE_EVAL
  METHOD QS

  STRESS_TENSOR ANALYTICAL 
  &PRINT
   &STRESS_TENSOR  LOW
    &EACH
     CELL_OPT 1
    &END EACH
   &END STRESS_TENSOR
   &FORCES
    &EACH 
      CELL_OPT 1
    &END EACH
   &END FORCES 
  &END PRINT

  &DFT

    &KPOINTS
      SCHEME MONKHORST-PACK 2 2 2  
    &END KPOINTS
    &QS
      METHOD DFTB
     
    EXTRAPOLATION USE_PREV_P

   &DFTB
    SELF_CONSISTENT TRUE
  HB_SR_GAMMA TRUE
  DIAGONAL_DFTB3 TRUE    ! Often used alongside HB_SR_GAMMA for 3ob parameters
  DISPERSION TRUE        ! Crucial for benzene high-pressure studies
  &PARAMETER
    PARAM_FILE_PATH __CP2K_SKF_PATH__
    PARAM_FILE_NAME 3ob-3-1.parameter
   DISPERSION_TYPE D3
    HB_SR_PARAM 4.0
    DISPERSION_PARAMETER_FILE ./dftd3.dat
  &END PARAMETER    

  &END DFTB    


    &END QS
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF 1.0E-8
      MAX_SCF 100

      ADDED_MOS 12

    &SMEAR T
     METHOD FERMI_DIRAC
     ELECTRONIC_TEMPERATURE 300  ! Set this to your simulation temperature
  &END SMEAR


     &DIAGONALIZATION ON      ! <--- THIS IS THE MISSING KEY
      ALGORITHM STANDARD     ! Standard diagonalization is robust for DFTB
    &END DIAGONALIZATION

      &MIXING
        METHOD DIRECT_P_MIXING 
        ALPHA 0.3
    NMIXING 3
    NBROYDEN 3
  
    &END MIXING
      &PRINT
        &RESTART OFF
        &END RESTART

      &END PRINT
      
   &END SCF
  &END DFT




  &SUBSYS
    &CELL
        @INCLUDE 'init_cell.cell'
     PERIODIC  XYZ
    &END CELL
   &COORD
      @INCLUDE 'coordinates_init.xyz'
    &END COORD
  
  &PRINT

  &ATOMIC_COORDINATES ON
    &EACH 
       GEO_OPT 1 
       CELL_OPT 1
        
     &END EACH
 
 &END ATOMIC_COORDINATES 
&END PRINT 

  &KIND C
    ELEMENT C
    LMAX_DFTB 1
    DFTB3_PARAM -0.1492
&END KIND

  &KIND H
    ELEMENT H
    LMAX_DFTB 0
   DFTB3_PARAM -0.1857
  &END KIND


 &END SUBSYS
&END FORCE_EVAL

&MOTION
  
  &CELL_OPT
   MAX_FORCE 2.0E-5
OPTIMIZER BFGS
    MAX_ITER 1000
    TYPE DIRECT_CELL_OPT
    EXTERNAL_PRESSURE 10000
    PRESSURE_TOLERANCE 50 
    
   &PRINT
     &CELL ON
      &EACH
        CELL_OPT 1
      &END EACH 
      FILENAME optimized_cell.dat
        ADD_LAST NUMERIC
  
         
      &END CELL
      
    &END PRINT
  

   &END CELL_OPT
 &PRINT 
   &TRAJECTORY ON
      
     &EACH 
         GEO_OPT 1
         CELL_OPT 1
     &END EACH 
     FILENAME POS
    &END TRAJECTORY 
 &END PRINT 




&END MOTION              

