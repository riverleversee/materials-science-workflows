# Copy to cluster.env and edit for your HPC account.
# cluster.env is gitignored.

# Slurm (edit #SBATCH --account= in submit scripts or override at submit time)
# export SLURM_ACCOUNT=your_account

# CP2K Apptainer image on the cluster
export CP2K_SIF=/path/to/cp2k.sif
export CP2K_EXE=/opt/cp2k/bin/cp2k.psmp

# DFTB SKF parameter directory (3ob files — not shipped in git)
export CP2K_SKF_PATH=/path/to/skfdatafiles

# Optional: override hydrostatic ramp location
# export HYDRO_DIR=/path/to/cp2k/hydroopt

# scfhel / optimizer: path to CP2K parameter_trend_matrices.txt from a uniax FD run
# export CP2K_PARAM_TREND_PATH=/path/to/uniax_manual/cbaxis/1gpadelta/15gpa/parameter_trend_matrices.txt
